{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Non-main builds upload an isolated version of the EXISTING Worker.
  // Do not merge this preview-only configuration into main before cutover review.
  "name": "xravity-site",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/.netlify/*", "/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
