---
import '../styles/global.css';
import '../styles/content.css';
import '../styles/light.css';
import Analytics from '../components/Analytics.astro';
import translations from '../../public/data/translations.json';
import { createHash } from 'node:crypto';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
  type?: string;
}

const {
  title = 'Xravity — AI, on your terms',
  description = 'Tools and ideas for a more capable, independent, and secure life in an AI-driven world.',
  lang = 'en',
  image = '/images/brand/xravity-og-image.jpg',
  type = 'website'
} = Astro.props;

const siteUrl = Astro.site?.toString()?.replace(/\/$/, '') ?? 'https://xravity.xyz';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL(image, siteUrl).toString();
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const translationsVersion = createHash('sha256').update(JSON.stringify(translations)).digest('hex').slice(0, 12);
---
<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme="light">
<head>
  <script is:inline>
    // Apply a remembered theme before first paint, without changing first-visit defaults.
    try { document.documentElement.dataset.theme = localStorage.getItem('xravity_theme') === 'dark' ? 'dark' : 'light'; } catch {}
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}

  <!-- Font preconnect for faster loading -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <meta id="theme-color-meta" name="theme-color" content="#f7f8fa" />
  <title>{title}</title>

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Xravity" />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Canonical -->
  <link rel="canonical" href={pageUrl} />
  <meta name="giscus:backlink" content={pageUrl} />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="Xravity Blog" href="/rss.xml" />

  <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
  <link rel="apple-touch-icon" href="/brand/favicon-180.png" />
  <Analytics />
</head>
<body data-translations-version={translationsVersion}>
  <!-- Keep Identity callback parameters intact and on this same origin. -->
  <script>
    import { identityRedirect } from '../utils/identity-redirect.mjs';
    const identityTarget = identityRedirect(window.location.href);
    if (identityTarget) window.location.replace(identityTarget);
  </script>

  <!-- Progress Bar -->
  <div id="progress-bar"></div>

  <!-- Back to Top -->
  <button id="back-to-top" title="Back to top" aria-label="Back to top" data-i18n-title="back_to_top" data-i18n-aria="back_to_top" type="button">&#8593;</button>

  <!-- Theme Toggle -->
  <button class="theme-toggle" id="themeToggle" title="Toggle theme" aria-label="Toggle theme" data-i18n-title="toggle_theme" data-i18n-aria="toggle_theme" type="button">
    <span>&#9788;</span>
  </button>

  <!-- Custom Cursor -->
  <div id="cursor-dot"></div>
  <div id="cursor-ring"></div>

  <!-- Particle Canvas -->
  <canvas id="particles" aria-hidden="true"></canvas>

  <slot />

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <script>
    import { createBrandNetwork } from '../scripts/brand-network';
    // ─── Theme ───
    let i18nMap: Record<string, string> = {};
    const themeToggle = document.getElementById('themeToggle')!;
    const themeColorMeta = document.getElementById('theme-color-meta') as HTMLMetaElement | null;
    function applyTheme(theme: string) {
      const dark = theme === 'dark';
      document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      themeToggle.querySelector('span')!.textContent = dark ? '☾' : '☼';
      if (themeColorMeta) themeColorMeta.content = dark ? '#0b0b0e' : '#f7f8fa';
    }
    function restoreTheme() {
      try { applyTheme(localStorage.getItem('xravity_theme') || 'light'); }
      catch { applyTheme(document.documentElement.dataset.theme || 'light'); }
    }
    restoreTheme();

    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const next = isDark ? 'light' : 'dark';
      applyTheme(next);
      try { localStorage.setItem('xravity_theme', next); } catch {}
    });
    window.addEventListener('storage', event => {
      if (event.key === 'xravity_theme' || event.key === null) restoreTheme();
    });
    window.addEventListener('pageshow', restoreTheme);

    // ─── Progress Bar & Back to Top ───
    const progressBar = document.getElementById('progress-bar')!;
    const backTop = document.getElementById('back-to-top')!;
    window.addEventListener('scroll', () => {
      const sc = window.scrollY;
      const ch = document.documentElement.scrollHeight - window.innerHeight;
      progressBar.style.width = (ch > 0 ? (sc / ch * 100) : 0) + '%';
      backTop.classList.toggle('visible', sc > 500);

      // Nav active state
      const sections = document.querySelectorAll('section[id]');
      let cur = '';
      sections.forEach(s => {
        if (sc >= s.offsetTop - 120) cur = s.id;
      });
      document.querySelectorAll('.nav-links a').forEach(a => {
        a.classList.toggle('active', a.getAttribute('href') === '#' + cur);
      });
    });
    backTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ─── Custom Cursor ───
    const dot = document.getElementById('cursor-dot')!;
    const ring = document.getElementById('cursor-ring')!;
    let mx = 0, my = 0, dx = 0, dy = 0, rx = 0, ry = 0;
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    if (finePointer && !reducedMotion) {
      document.addEventListener('mousemove', e => {
        mx = e.clientX; my = e.clientY;
        dot.style.visibility = 'visible'; ring.style.visibility = 'visible';
      });
      const hideCursor = () => { dot.style.visibility = 'hidden'; ring.style.visibility = 'hidden'; };
      window.addEventListener('blur', hideCursor);
      document.addEventListener('mouseleave', hideCursor);

      document.querySelectorAll('a,button,.blog-card,.gallery-item,.contact-link,.skill-card,.principle-card,.section-block,.hero-signal')
        .forEach(el => {
          el.addEventListener('mouseenter', () => ring.classList.add('hover'));
          el.addEventListener('mouseleave', () => ring.classList.remove('hover'));
        });

      (function animateCursor() {
        dx += (mx - dx) * 0.3;
        dy += (my - dy) * 0.3;
        dot.style.transform = 'translate(' + dx + 'px, ' + dy + 'px)';
        rx += (mx - rx) * 0.12;
        ry += (my - ry) * 0.12;
        ring.style.transform = 'translate(' + (rx - 20) + 'px, ' + (ry - 20) + 'px)';
        requestAnimationFrame(animateCursor);
      })();
    }

    // ─── Particles ───
    createBrandNetwork(document.getElementById('particles') as HTMLCanvasElement);
    document.querySelectorAll<HTMLCanvasElement>('.brand-network').forEach(canvas => createBrandNetwork(canvas, true));

    // ─── Toast helper ───
    function toast(msg: string) {
      const t = document.getElementById('toast')!;
      t.textContent = msg;
      t.classList.add('show');
      clearTimeout((t as any)._tid);
      (t as any)._tid = setTimeout(() => t.classList.remove('show'), 2200);
    }
    (window as any).toast = toast;

    // ─── Language Toggle ───
    // Chinese is the first-visit default; an explicit English choice is remembered.
    let curLang = 'zh';
    try { curLang = localStorage.getItem('xravity_lang') === 'en' ? 'en' : 'zh'; } catch {}
    const langBtn = document.getElementById('langToggle');
    const updateLangBtn = () => {
      if (langBtn) langBtn.innerHTML = curLang === 'zh' ? 'EN | <strong>中文</strong>' : '<strong>EN</strong> | 中文';
    };
    if (langBtn) {
      updateLangBtn();

      langBtn.addEventListener('click', async () => {
        curLang = curLang === 'en' ? 'zh' : 'en';
        try { localStorage.setItem('xravity_lang', curLang); } catch {}
        document.documentElement.lang = curLang === 'zh' ? 'zh-CN' : 'en';
        updateLangBtn();
        await applyTranslations(curLang);
        toast(curLang === 'zh' ? tr('lang_switched_zh') : tr('lang_switched_en'));
      });
    }

    // ─── Bilingual ───
    function tr(key: string, fallback = '') {
      return i18nMap[key] || fallback || key;
    }
    (window as any).xravityT = tr;

    async function loadTranslations(lang: string) {
      const map: Record<string, string> = {};
      try {
        const version = document.body.dataset.translationsVersion;
        const res = await fetch(`/data/translations.json?v=${version || 'legacy'}`);
        const data = await res.json();
        // English keys
        for (const [k, v] of Object.entries(data)) {
          if (k !== 'zh' && typeof v === 'string') map[k] = v;
        }
        // Chinese overrides
        if (lang === 'zh' && data.zh) {
          for (const [k, v] of Object.entries(data.zh)) {
            if (typeof v === 'string') map[k] = v;
          }
        }
      } catch(e) { console.warn('Translation load failed:', e); }
      return map;
    }

    async function applyTranslations(lang: string) {
      const map = await loadTranslations(lang);
      // A slower earlier request must not overwrite the newest language choice.
      if (lang !== curLang) return;
      i18nMap = map;

      document.querySelectorAll<HTMLTimeElement>('time[data-local-date]').forEach(el => {
        const date = new Date(el.dataset.localDate || '');
        if (!Number.isNaN(date.getTime())) el.textContent = new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric' }).format(date);
      });

      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = (el as HTMLElement).dataset.i18n;
        if (!key || !map[key]) return;
        // Both languages use the same source of truth. Restoring cached HTML
        // would resurrect old English labels after a Chinese → English switch.
        el.innerHTML = map[key];
      });

      document.querySelectorAll('[data-i18n-title]').forEach(el => {
        const key = (el as HTMLElement).dataset.i18nTitle;
        if (key && map[key]) el.setAttribute('title', map[key]);
      });

      document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
        const key = (el as HTMLElement).dataset.i18nPlaceholder;
        if (key && map[key]) el.setAttribute('placeholder', map[key]);
      });

      document.querySelectorAll('[data-i18n-aria]').forEach(el => {
        const key = (el as HTMLElement).dataset.i18nAria;
        if (key && map[key]) el.setAttribute('aria-label', map[key]);
      });

      document.dispatchEvent(new CustomEvent('xravity:i18n', { detail: { lang, map } }));
    }

    function restoreLanguage() {
      let next = curLang;
      try { next = localStorage.getItem('xravity_lang') === 'en' ? 'en' : 'zh'; } catch {}
      if (next === curLang) return;
      curLang = next;
      document.documentElement.lang = curLang === 'zh' ? 'zh-CN' : 'en';
      updateLangBtn();
      applyTranslations(curLang);
    }
    window.addEventListener('storage', event => {
      if (event.key === 'xravity_lang' || event.key === null) restoreLanguage();
    });
    window.addEventListener('pageshow', restoreLanguage);

    // Init language
    document.addEventListener('DOMContentLoaded', () => {
      document.documentElement.lang = curLang === 'zh' ? 'zh-CN' : 'en';
      applyTranslations(curLang);
    });
    // apply on load if DOM already ready
    if (document.readyState !== 'loading') {
      document.documentElement.lang = curLang === 'zh' ? 'zh-CN' : 'en';
      applyTranslations(curLang);
    }
  </script>
</body>
</html>
