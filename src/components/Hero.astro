<section id="hero">
  <div class="container hero-layout">
    <div class="hero-content">
      <p class="hero-tag" data-i18n="hero_tag">AI, on your terms</p>
      <h1 class="hero-headline">
        <span data-i18n="hero_title_1">Be more capable,</span>
        <span data-i18n="hero_title_2">more independent,</span>
        <span class="hero-accent" data-i18n="hero_title_3">more secure</span>
        <span class="hero-tail" data-i18n="hero_title_4">in an AI-driven world.</span>
      </h1>
      <p class="hero-sub" data-i18n="hero_sub">
        We build tools and share ideas that put AI's power in your hands. More possibility, without giving up your independence.
      </p>
      <div class="hero-actions">
        <a href="#vision" class="hero-cta" data-i18n="hero_cta">Watch the vision film</a>
        <a href="#products" class="hero-secondary" data-i18n="hero_secondary">Explore what we're building</a>
      </div>
    </div>

    <div class="hero-signal brand-field" aria-hidden="true">
      <canvas class="brand-network"></canvas>
      <div class="field-heading"><span>XR / 001</span><span data-i18n="field_heading">A field of possibility</span></div>
      <img class="field-mark" src="/brand/xravity-mark.svg" alt="" width="220" height="210" fetchpriority="high" />
      <span class="field-coordinate">X — RAVITY</span>
      <span class="field-principle field-principle-one"><i>01</i><b data-i18n="principle_capability_title">Capability</b></span>
      <span class="field-principle field-principle-two"><i>02</i><b data-i18n="principle_independence_title">Independence</b></span>
      <span class="field-principle field-principle-three"><i>03</i><b data-i18n="principle_security_title">Security</b></span>
      <div class="field-footer"><span data-i18n="field_footer">Not another orbit. Your own trajectory.</span><span>↗</span></div>
    </div>
  </div>
  <div
    class="scroll-indicator"
    id="scrollIndicator"
    role="button"
    tabindex="0"
    aria-label="Scroll to principles"
    data-i18n-aria="scroll_to_principles"
  >
    <span class="line"></span>
    <small data-i18n="scroll">Scroll</small>
  </div>
</section>

<script>
  const scrollIndicator = document.getElementById('scrollIndicator');
  const scrollToPrinciples = () => {
    document.getElementById('principles')?.scrollIntoView({ behavior: 'smooth' });
  };
  scrollIndicator?.addEventListener('click', scrollToPrinciples);
  scrollIndicator?.addEventListener('keydown', event => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      scrollToPrinciples();
    }
  });
</script>
