---
import StoryText from './StoryText.astro';
import copy from '../../public/data/translations.json';
---
<section id="hero">
  <div class="container hero-layout">
    <div class="hero-content">
      <p class="hero-tag"><StoryText zh="独立的工具  清醒的思考" en="Independent tools  clear thinking" /></p>
      <h1 class="hero-headline">
        <span><StoryText zh={copy.zh.hero_title_1} en={copy.hero_title_1} /></span>
        <span><StoryText zh={copy.zh.hero_title_2} en={copy.hero_title_2} /></span>
        <span class="hero-accent"><StoryText zh={copy.zh.hero_title_3} en={copy.hero_title_3} /></span>
        <span class="hero-tail"><StoryText zh={copy.zh.hero_title_4} en={copy.hero_title_4} /></span>
      </h1>
      <p class="hero-sub"><StoryText zh={copy.zh.hero_sub} en={copy.hero_sub} /></p>
      <div class="hero-actions">
        <a href="#products" class="hero-cta"><StoryText zh="探索我们的产品" en="Explore our products" /></a>
        <a href="/vision/" class="hero-secondary"><StoryText zh="为什么做这件事" en="Why we're building" /></a>
      </div>
    </div>
    <div class="hero-signal hero-workbench">
      <canvas class="brand-network" aria-hidden="true"></canvas>
      <div class="workbench-top"><span>XR / LAB 01</span><span class="workbench-kicker"><StoryText zh="从想法到工具" en="From ideas to tools" /></span></div>
      <div class="workbench-product">
        <p class="workbench-label"><StoryText zh="正在打造" en="In the making" /></p>
        <h2><StoryText zh={copy.zh.tiljot_name} en={copy.tiljot_name} /></h2>
        <p><StoryText zh={copy.zh.tiljot_tagline} en={copy.tiljot_tagline} /></p>
      </div>
      <div class="workbench-flow" aria-hidden="true">
        <div class="watch-preview"><div class="watch-face"><div class="voice-wave">{[1,2,3,4,5,6,7].map(n=><i style={`--bar:${n}`}></i>)}</div><span><StoryText zh="说出想法" en="An idea, spoken" /></span></div></div>
        <div class="flow-connector"><span></span><b>↗</b></div>
        <div class="mac-preview"><div class="mac-toolbar"><i></i><i></i><i></i><span>TilJot</span></div><div class="mac-content"><p><StoryText zh="想法  从这里开始" en="Ideas start here" /></p><span class="typing-line"></span><span class="typing-line short"></span><span class="input-caret"></span></div></div>
      </div>
      <div class="workbench-steps"><span>01 / APPLE WATCH</span><span>02 / MAC</span></div>
      <div class="workbench-bottom"><span><StoryText zh="语音在 Mac 本地识别" en="Recognized locally on your Mac" /></span><a href="/tiljot/"><StoryText zh="了解提腕记" en="Explore TilJot" /> <b aria-hidden="true">↗</b></a></div>
      <p class="workbench-note"><StoryText zh="工作流程示意" en="Workflow illustration" /></p>
    </div>
    <nav class="home-index" aria-label="Explore Xravity"><a href="#products"><span>01</span><StoryText zh="产品与工具" en="Products & tools" /><b aria-hidden="true">↗</b></a><a href="/blog/"><span>02</span><StoryText zh="实践与思考" en="Notes & ideas" /><b aria-hidden="true">↗</b></a><a href="/resources/"><span>03</span><StoryText zh="精选资源" en="Useful resources" /><b aria-hidden="true">↗</b></a></nav>
  </div>
</section>
