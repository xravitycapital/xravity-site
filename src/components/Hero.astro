---
import siteData from '../data/site.json';
---

<section id="hero">
  <div class="hero-content">
    <p class="hero-tag" data-i18n="hero_tag">
      {siteData.hero.tag}
    </p>
    <h1 class="hero-name" aria-label="Xravity">
      <span class="x">X</span><span data-i18n="hero_name">{siteData.hero.name}</span>
    </h1>
    <p class="hero-sub" data-i18n="hero_sub">
      {siteData.hero.sub}
    </p>
    <a href="#about" class="hero-cta" data-i18n="hero_cta">
      {siteData.hero.cta}
    </a>
  </div>
  <div
    class="scroll-indicator"
    id="scrollIndicator"
    role="button"
    tabindex="0"
    aria-label="Scroll to About"
    data-i18n-aria="scroll_to_about"
  >
    <span class="line"></span>
    <small data-i18n="scroll">Scroll</small>
  </div>
</section>

<script>
  const scrollIndicator = document.getElementById('scrollIndicator');
  const scrollToAbout = () => {
    document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
  };
  scrollIndicator?.addEventListener('click', scrollToAbout);
  scrollIndicator?.addEventListener('keydown', event => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      scrollToAbout();
    }
  });
</script>
