    </div>
    <div class="vision-player" data-brand-reveal>
      <video controls preload="none" playsinline poster="/film/xravity-vision-poster.jpg" aria-label="Xravity vision film" data-i18n-aria="vision_video_label">
        <source src="/film/xravity-vision-web.mp4" type="video/mp4" />
        <p><a href="/film/xravity-vision-web.mp4" data-i18n="vision_download">Open the vision film</a></p>
