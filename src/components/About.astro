---
import siteData from '../data/site.json';
---

<section id="about" data-field="gold">
  <div class="container">
    <p class="section-tag" data-i18n="about_tag">About Xravity</p>
    <h2 class="section-title" data-i18n="about_title">An independent technology studio for the AI era.</h2>

    <div class="about-grid">
      <div class="about-text">
        <p data-i18n="about_p1" set:html="Xravity is an independent technology studio helping people stay capable, independent, and secure as AI changes the way we work." />
        <p data-i18n="about_p2">We share practical ideas, useful resources, and focused tools for people who want more agency over their work and future.</p>
        <p data-i18n="about_p3">The long-term goal is simple: make technology feel more understandable, more useful, and more yours.</p>
      </div>
      <div>
        <div class="timeline">
          {siteData.timeline.map((item, index) => (
            <div class="timeline-item">
              <div class="timeline-content">
                <div class="timeline-year" data-i18n={`timeline_${index}_year`}>{item.year}</div>
                <div class="timeline-title" data-i18n={`timeline_${index}_title`}>{item.title}</div>
                <div class="timeline-desc">
                  <span data-i18n={`timeline_${index}_desc`}>{item.desc}</span> — <em data-i18n={`timeline_${index}_org`}>{item.org}</em>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <p class="section-tag" style="margin-top:5rem;" data-i18n="skills_tag">Expertise</p>
    <h3 class="section-title" style="font-size:1.8rem;margin-bottom:2rem;" data-i18n="skills_title">Skills</h3>

    <div class="skills-grid">
      {siteData.skills.map((skill, index) => (
        <div class="skill-card">
          <div class="skill-icon">{skill.icon}</div>
          <div class="skill-name" data-i18n={`skill_${index}_name`}>{skill.name}</div>
          <div class="skill-level" data-i18n={`skill_${index}_level`}>{skill.level}</div>
        </div>
      ))}
    </div>
  </div>
</section>
