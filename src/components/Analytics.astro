---
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-60NSLRCLLD';
---

<meta name="xravity-analytics-id" content={gaMeasurementId} />
<script>
  import { startAnalytics } from '../scripts/analytics.mjs';
  startAnalytics(document.querySelector('meta[name="xravity-analytics-id"]')?.getAttribute('content'));
</script>
