---
interface Props { zh: string; en: string; heading?: 'h1' | 'h2' | 'h3' | 'p' | 'span'; tone?: string; size?: string; motion?: string; class?: string; }
const { zh, en, heading = 'h2', tone = '', size = '', motion = 'chars', class: extra = '' } = Astro.props;
const Tag = heading;
---
<div class:list={['xr-bi', tone && `is-${tone}`, size, extra]}>
  <Tag class="zh" lang="zh-CN" data-story-locale="zh" data-xr={motion}>{zh}</Tag>
  <Tag class="en" lang="en" data-story-locale="en" data-xr={motion === 'slam' ? 'slam' : 'words'}>{en}</Tag>
</div>
