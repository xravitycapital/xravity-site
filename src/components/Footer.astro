---
interface Props { stacked?: boolean; }
const { stacked = false } = Astro.props;
---
<footer data-field="gold">
  <a class="footer-brand" href="/#hero" aria-label="Xravity"><img src={stacked ? '/brand/xravity-lockup-stacked.svg' : '/brand/xravity-lockup-horizontal.svg'} width={stacked ? 360 : 438} height={stacked ? 360 : 100} alt="Xravity" loading="lazy" /></a>
  <p class="footer-motto" data-i18n="footer_motto">MORE CAPABLE · MORE INDEPENDENT · MORE SECURE</p>
  <nav class="footer-links" aria-label="Footer">
    <a href="/blog" data-i18n="nav_blog">Blog</a>
    <a href="/resources" data-i18n="nav_resources">Resources</a>
    <a href="/privacy" data-i18n="nav_privacy">Privacy</a>
    <a href="/rss.xml" data-i18n="nav_rss">RSS</a>
  </nav>
  <p data-i18n="footer_text">&copy; 2026 Xravity. Built for human agency in an AI-driven world.</p>
</footer>
