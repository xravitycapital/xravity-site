---
import { tiljotCopy } from '../../data/tiljot-copy';
const c = tiljotCopy.en;
const title = c.title;
const description = c.description;
const url = 'https://xravity.xyz/tiljot/';
const logo = '/images/tiljot/tiljot-logo.png';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11182d" />
    <script is:inline>
      // Read the shared preference before first paint, without requiring storage access.
      (() => {
        let theme = 'light';
        let lang = 'en';
        try {
          if (localStorage.getItem('xravity_theme') === 'dark') theme = 'dark';
          if (localStorage.getItem('xravity_lang') === 'zh') lang = 'zh';
        } catch {}
        document.documentElement.dataset.theme = theme;
        document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
        document.querySelector('meta[name="theme-color"]').content = theme === 'dark' ? '#0d0d14' : '#fafaf7';
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" href={logo} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`https://xravity.xyz${logo}`} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={`https://xravity.xyz${logo}`} />
  </head>
  <body>
    <header><a class="site-wordmark" href="/">Xravity</a><nav aria-label={c.navigation} data-tj-aria="navigation"><a href="/#products" data-tj-i18n="back">{c.back}</a><span data-tj-i18n="product">{c.product}</span><div class="preferences"><button id="tiljotLangToggle" type="button" aria-label={c.language}><strong>EN</strong> | 中文</button><button id="tiljotThemeToggle" type="button" aria-label={c.toDark}><span aria-hidden="true">☾</span><span class="theme-label">{c.dark}</span></button></div></nav></header>
    <main>
      <section class="hero" aria-labelledby="product-title">
        <img class="logo" src={logo} width="600" height="600" alt={c.logo} data-tj-alt="logo" fetchpriority="high" />
        <p class="status" data-tj-i18n="status">{c.status}</p>
        <h1 id="product-title" data-tj-i18n="name">{c.name}</h1>
        <p class="tagline" data-tj-i18n="tagline">{c.tagline}</p>
        <p class="intro"><span data-tj-i18n="introOne">{c.introOne}</span>{' '}<br class="desktop-break" /><span data-tj-i18n="introTwo">{c.introTwo}</span></p>
        <a class="contact" href="mailto:xravityai@outlook.com?subject=TilJot%20beta%20testing" data-tj-i18n="contact">{c.contact}</a>
        <a id="tiljotBetaDownload" class="beta-download" href="https://tiljot-beta-downloads.netlify.app/?lang=en&amp;theme=light" referrerpolicy="no-referrer" data-tj-i18n="download">{c.download}</a>
        <p class="availability" data-tj-i18n="availability">{c.availability}</p>
      </section>
      <section class="features" aria-label={c.capabilities} data-tj-aria="capabilities">
        <article><span>01 / INPUT</span><h2 data-tj-i18n="inputTitle">{c.inputTitle}</h2><p data-tj-i18n="inputText">{c.inputText}</p></article>
        <article><span>02 / LOCAL</span><h2 data-tj-i18n="localTitle">{c.localTitle}</h2><p data-tj-i18n="localText">{c.localText}</p></article>
        <article><span>03 / CONTROL</span><h2 data-tj-i18n="controlTitle">{c.controlTitle}</h2><p data-tj-i18n="controlText">{c.controlText}</p></article>
      </section>
      <section class="details" aria-labelledby="beta-title">
        <div><h2 id="beta-title" data-tj-i18n="betaTitle">{c.betaTitle}</h2><p data-tj-i18n="betaText">{c.betaText}</p></div>
        <dl><dt data-tj-i18n="devices">{c.devices}</dt><dd data-tj-i18n="devicesText">{c.devicesText}</dd><dt data-tj-i18n="limits">{c.limits}</dt><dd data-tj-i18n="limitsText">{c.limitsText}</dd><dt data-tj-i18n="network">{c.network}</dt><dd data-tj-i18n="networkText">{c.networkText}</dd></dl>
      </section>
    </main>
    <footer><span data-tj-i18n="footer">{c.footer}</span><a href="/tiljot/support/" data-tj-i18n="support">{c.support}</a><a href="/tiljot/privacy/" data-tj-i18n="privacy">{c.privacy}</a><a href="mailto:xravityai@outlook.com">xravityai@outlook.com</a></footer>
  </body>
</html>

<script>
  import { tiljotCopy } from '../../data/tiljot-copy';
  let language: 'en' | 'zh' = 'en';
  const langToggle = document.getElementById('tiljotLangToggle')!;
  const toggle = document.getElementById('tiljotThemeToggle')!;
  const icon = toggle.querySelector('[aria-hidden]')!;
  const label = toggle.querySelector('.theme-label')!;
  function applyTheme(theme: string) {
    const dark = theme === 'dark';
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    const c = tiljotCopy[language];
    toggle.setAttribute('aria-label', dark ? c.toLight : c.toDark);
    icon.textContent = dark ? '☼' : '☾';
    label.textContent = dark ? c.light : c.dark;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0d0d14' : '#fafaf7');
    const download = document.getElementById('tiljotBetaDownload') as HTMLAnchorElement;
    const address = new URL(download.href);
    address.searchParams.set('lang', language);
    address.searchParams.set('theme', dark ? 'dark' : 'light');
    download.href = address.href;
  }
  function applyLanguage(lang: string) {
    language = lang === 'zh' ? 'zh' : 'en';
    const c = tiljotCopy[language];
    const value = (key: string) => c[key as keyof typeof c];
    document.documentElement.lang = language === 'zh' ? 'zh-CN' : 'en';
    document.title = c.title;
    document.querySelectorAll<HTMLElement>('[data-tj-i18n]').forEach(el => {
      const text = value(el.dataset.tjI18n!);
      if (text) el.textContent = text;
    });
    document.querySelectorAll<HTMLElement>('[data-tj-aria]').forEach(el => el.setAttribute('aria-label', value(el.dataset.tjAria!)));
    document.querySelectorAll<HTMLElement>('[data-tj-alt]').forEach(el => el.setAttribute('alt', value(el.dataset.tjAlt!)));
    document.querySelector('meta[name="description"]')?.setAttribute('content', c.description);
    document.querySelector('meta[property="og:title"]')?.setAttribute('content', c.title);
    document.querySelector('meta[property="og:description"]')?.setAttribute('content', c.description);
    langToggle.innerHTML = language === 'zh' ? 'EN | <strong>中文</strong>' : '<strong>EN</strong> | 中文';
    langToggle.setAttribute('aria-label', c.language);
    applyTheme(document.documentElement.dataset.theme || 'light');
  }
  function restoreLanguage() {
    try { applyLanguage(localStorage.getItem('xravity_lang') || 'en'); }
    catch { applyLanguage(document.documentElement.lang.startsWith('zh') ? 'zh' : 'en'); }
  }
  function restoreTheme() {
    try { applyTheme(localStorage.getItem('xravity_theme') || 'light'); }
    catch { applyTheme(document.documentElement.dataset.theme || 'light'); }
  }
  restoreTheme();
  restoreLanguage();
  langToggle.addEventListener('click', () => {
    const next = language === 'en' ? 'zh' : 'en';
    applyLanguage(next);
    try { localStorage.setItem('xravity_lang', next); } catch {}
  });
  toggle.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(next);
    try { localStorage.setItem('xravity_theme', next); } catch {}
  });
  window.addEventListener('storage', event => {
    if (event.key === 'xravity_theme' || event.key === null) restoreTheme();
    if (event.key === 'xravity_lang' || event.key === null) restoreLanguage();
  });
  window.addEventListener('pageshow', restoreTheme);
  window.addEventListener('pageshow', restoreLanguage);
</script>

<style>
  :global(html) { --tj-bg: #fafaf7; --tj-text: #1a1a24; --tj-muted: #525e75; --tj-nav: #686879; --tj-card: #fff; --tj-border: rgba(0,0,0,.12); --tj-link: #3352ad; --tj-label: #586da2; --tj-wordmark: linear-gradient(135deg, #b8860b, #8b5e3c 40%, #4a6b6b); color-scheme: light; }
  :global(html[data-theme="dark"]) { --tj-bg: #0d0d14; --tj-text: #e8e8f0; --tj-muted: #b4b4c8; --tj-nav: #b1b1c6; --tj-card: #181824; --tj-border: rgba(255,255,255,.12); --tj-link: #a6b8ff; --tj-label: #adbaff; --tj-wordmark: linear-gradient(135deg, #d4a843, #b8866c 40%, #5c8a8a); color-scheme: dark; }
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: var(--tj-bg); color: var(--tj-text); font: 16px/1.8 "Inter", "Noto Sans SC", "PingFang SC", -apple-system, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: var(--tj-link); text-underline-offset: 4px; }
  :global(a:focus-visible), button:focus-visible { outline: 3px solid #7893ff; outline-offset: 5px; }
  header, main, footer { width: min(1100px, 100% - 48px); margin-inline: auto; }
  header { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-block: 28px 36px; font-size: 14px; }
  header a { color: var(--tj-nav); text-decoration: none; }
  header a:hover { color: #b8860b; }
  header a.site-wordmark { font: 700 26px "Playfair Display", Georgia, serif; letter-spacing: .04em; background: var(--tj-wordmark); background-clip: text; -webkit-background-clip: text; color: transparent; }
  header nav { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; justify-content: flex-end; }
  header span { color: var(--tj-nav); letter-spacing: .06em; }
  .preferences { display: flex; gap: 10px; }
  .preferences button { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 6px 14px; border: 1px solid var(--tj-border); border-radius: 50px; background: var(--tj-card); color: var(--tj-text); font: inherit; cursor: pointer; white-space: nowrap; }
  .preferences button:hover { border-color: #7893ff; }
  .hero { background: radial-gradient(ellipse at top, #25365d, #11182d 65%); color: #f7f8fc; border-radius: 14px; padding: 60px 28px 38px; text-align: center; }
  .logo { display: block; width: 148px; height: 148px; margin: 0 auto 22px; border-radius: 28px; }
  .status { display: inline-block; color: #c9d3f9; background: #263351; border: 1px solid #475474; border-radius: 20px; padding: 3px 14px; font-size: 12px; }
  h1 { font-size: clamp(42px, 8vw, 64px); margin: 12px 0 0; letter-spacing: -.045em; line-height: 1.25; }
  .tagline { font-size: clamp(23px, 4vw, 32px); margin: 12px 0 20px; font-weight: 500; }
  .intro { color: #c4cde2; margin: 0 auto 28px; max-width: 680px; }
  .contact { display: inline-block; background: #7893ff; color: #101a34; text-decoration: none; padding: 10px 25px; border-radius: 12px; font-weight: 650; }
  .contact:hover { background: #9aafff; }
  .beta-download { display: inline-block; color: #d8e1ff; border: 1px solid #7086b4; border-radius: 12px; padding: 9px 20px; margin: 12px; text-decoration: none; font-weight: 600; }
  .beta-download:hover { background: #263351; }
  .availability { color: #adb9d5; font-size: 12px; margin-top: 18px; }
  .features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 26px 0; }
  article { background: var(--tj-card); border: 1px solid var(--tj-border); border-radius: 14px; padding: 28px; }
  article span { color: var(--tj-label); font-size: 11px; letter-spacing: .12em; }
  h2 { font-family: "Noto Serif SC", Georgia, serif; font-size: 21px; line-height: 1.55; margin: 12px 0; }
  article p, .details p, dd, .english p { color: var(--tj-muted); margin-bottom: 0; }
  .details { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; padding: 42px 30px; border-block: 1px solid var(--tj-border); }
  dl { margin: 0; } dt { font-weight: 650; } dt:not(:first-child) { margin-top: 22px; } dd { margin: 5px 0 0; font-size: 14px; }
  .english { padding: 32px 30px 20px; max-width: 850px; }
  .english p { font-size: 14px; }
  footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--tj-nav); padding-block: 30px 40px; }
  @media (max-width: 720px) { header, main, footer { width: min(100% - 28px, 1100px); } header { align-items: flex-start; } header nav { gap: 6px 16px; font-size: 12px; } .features, .details { grid-template-columns: 1fr; } .features { gap: 14px; } .hero { padding: 38px 20px 28px; } .logo { width: 120px; height: 120px; border-radius: 22px; } .details { gap: 24px; padding: 26px 14px; } .english { padding: 22px 14px; } .desktop-break { display: none; } }
</style>
