---
import '../../styles/xravity-tokens.css';
import '../../styles/narrative.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import NarrativeHero from '../../components/NarrativeHero.astro';
import Vision from '../../components/Vision.astro';
import NarrativePromises from '../../components/NarrativePromises.astro';
import NarrativeProduct from '../../components/NarrativeProduct.astro';
import NarrativeSections from '../../components/NarrativeSections.astro';
